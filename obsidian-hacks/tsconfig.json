{
  "compilerOptions": {
    "module": "ESNext",
    "target": "es6",
    "allowJs": false,
    "noImplicitAny": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
