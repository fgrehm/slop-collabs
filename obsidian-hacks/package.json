{
  "name": "obsidian-hacks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "generate-css": "node scripts/generate-css.mjs",
    "build": "npm run generate-css && npm run typecheck && node esbuild.config.mjs production",
    "lint": "prek run --all-files"
  },
  "devDependencies": {
    "@types/node": "latest",
    "esbuild": "latest",
    "obsidian": "latest",
    "typescript": "latest"
  }
}
