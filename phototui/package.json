{
  "name": "phototui",
  "version": "0.1.0",
  "description": "A POC terminal album viewer/manager/organizer built on OpenTUI",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "fetch": "bun scripts/fetch.ts",
    "scale": "bun scripts/scale.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.5.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
